{
  "name": "Swiggy Official Brand Theme",
  "dataColors": [
    "#FC8019",
    "#48C479",
    "#FFA700",
    "#E23744",
    "#00B4D8",
    "#7B2CBF",
    "#282C3F",
    "#686B78",
    "#FF5722",
    "#2EC4B6"
  ],
  "background": "#181820",
  "foreground": "#FFFFFF",
  "tableAccent": "#FC8019",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI",
      "color": "#FC8019"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#FFFFFF"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#FC8019"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#A0A4B8"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#242633" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#333748" } },
            "radius": 8
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#181820" } },
            "transparency": 0
          }
        ]
      }
    }
  }
}
