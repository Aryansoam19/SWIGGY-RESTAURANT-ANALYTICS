{
  "name": "Swiggy Official Brand Theme",
  "dataColors": [
    "#FC8019",
    "#48C479",
    "#FFA700",
    "#E23744",
    "#00B4D8",
    "#7B2CBF",
    "#282C3F",
    "#686B78",
    "#FF5722",
    "#2EC4B6"
  ],
  "background": "#1C1C24",
  "foreground": "#FFFFFF",
  "tableAccent": "#FC8019",
  "visualStyles": {
    "*": {
      "*": {
        "*": {
          "fontFamily": "Segoe UI Semibold"
        },
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#242633" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#333748" } },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "position": "Outer",
            "preset": "Custom",
            "transparency": 60,
            "blur": 8,
            "angle": 90,
            "distance": 4
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 13,
            "fontFamily": "Segoe UI Bold",
            "alignment": "Left"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#181820" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#FC8019" } },
            "fontSize": 24,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#A0A4B8" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": { "solid": { "color": "#FC8019" } },
            "fontSize": 11,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "background": { "solid": { "color": "#242633" } },
            "fontSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#FC8019" } },
            "fontSize": 11,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "backColorPrimary": { "solid": { "color": "#242633" } },
            "fontColorSecondary": { "solid": { "color": "#E0E2EC" } },
            "backColorSecondary": { "solid": { "color": "#1F212D" } },
            "fontSize": 10
          }
        ]
      }
    }
  }
}
