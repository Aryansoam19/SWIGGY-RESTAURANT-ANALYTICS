{
  "name": "Swiggy Deep Navy Official Theme",
  "dataColors": [
    "#FC8019",
    "#00D284",
    "#9D62F8",
    "#38BDF8",
    "#FFA700",
    "#E23744",
    "#FFB067",
    "#62738E"
  ],
  "background": "#070B19",
  "foreground": "#FFFFFF",
  "tableAccent": "#FC8019",
  "textClasses": {
    "callout": {
      "fontSize": 22,
      "fontFace": "Segoe UI Bold",
      "color": "#FFFFFF"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Bold",
      "color": "#FFFFFF"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#FC8019"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#8B9BB4"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#0D152A" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#162444" } },
            "radius": 12
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#070B19" } },
            "transparency": 0
          }
        ]
      }
    }
  }
}
